# Kopiere diese Datei nach .env und trage eigene Werte ein. Keine echten Zugangsdaten committen!

# --- Server ---
PORT=3001
# Öffentliche Adresse der App (für Links in Passwort-Reset-E-Mails)
APP_URL=http://localhost:5173
# --- Datenbank ---
# PostgreSQL-Verbindung (z. B. auf Render automatisch gesetzt). Leer lassen => lokale
# eingebaute Postgres-Datenbank (PGlite) im Verzeichnis DATA_DIR/pglite, keine Installation nötig.
DATABASE_URL=
# true, wenn die Datenbank nur per TLS erreichbar ist (z. B. externe Render-URL)
DATABASE_SSL=false
DATA_DIR=./data
# Anzahl vorgeschalteter Proxys (Render: 1), damit Ratenbegrenzungen die echte Client-IP sehen
TRUST_PROXY=

# --- Marktdaten (Twelve Data, https://twelvedata.com) ---
# Leer lassen => Demo-Modus mit Beispieldaten („Demo – keine echten Marktdaten“)
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=

# Cache-Dauer in Sekunden
QUOTE_CACHE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=3600
SEARCH_CACHE_TTL_SECONDS=86400

# --- E-Mail-Versand für Passwort-Reset (SMTP) ---
# Leer lassen => lokaler Modus: Reset-Links werden NUR in der Server-Konsole ausgegeben
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aktien-Tracker <noreply@example.com>"
